# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca vai pro Git; este exemplo vai, porque só tem nomes de
# variável, nenhum segredo dentro.

# ---- LLM (Etapa 5) ----
# Camada trocável de cliente LLM; "gemini" é a implementação padrão.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Banco de dados (Etapa 1) ----
DATABASE_PATH=

# ---- Envio de e-mail (Etapas 7 e 8) ----
# Senha de APP do Google (não a senha normal da conta), gerada em
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_DESTINATARIO=
